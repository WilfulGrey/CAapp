# Ignore per-user Claude Code state but commit shared skills.
# Pattern uses wildcard + negation: gitignore can't un-ignore inside a
# fully-ignored directory, so we ignore CONTENTS of .claude (with /*)
# then re-include the skills subtree.
.claude/*
!.claude/skills/
!.claude/skills/**
coverage/
# Onboarding paczki dla nowych devów — mogą zawierać klucze .env w plain text.
# Trzymaj poza repo, przekaż osobnym kanałem (Signal / 1Password / GPG).
*-env-package.zip
*-env-package/
# project 3 (Primundus calculator, Next.js) co-locates here so we can ship
# it alongside the CA app from a single Render Blueprint. Its own
# project 3/.gitignore keeps node_modules / .env / .next out of the repo.
