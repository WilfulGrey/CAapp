# ─── Per-environment values (prod vs staging) ─────────────────────────
# Wartości poniżej są dla PROD. Render staging slot
# (kostenrechner-staging.onrender.com) ma w swoim env wpisane staging
# Supabase + staging portal URL. Patrz docs/staging-environment-plan.md.

# Public site URL — used by SMTP templates and SEO meta.
#   Prod:    https://kostenrechner.primundus.de
#   Staging: https://kostenrechner-staging.onrender.com
NEXT_PUBLIC_SITE_URL=https://kostenrechner.primundus.de

# CA app (kundenportal) — handoff target after the calculator result page.
# The result page redirects the customer here with ?token=<lead.token>.
# The Eingangsbestätigung email also embeds this URL as a magic link.
#   Prod:    https://kundenportal.primundus.de
#   Staging: https://caapp-staging.onrender.com
#   Local:   http://localhost:5173
NEXT_PUBLIC_PORTAL_URL=https://kundenportal.primundus.de

# Admin login (server-only). Per-environment — staging admin has its own
# weaker password since data is non-sensitive.
ADMIN_PASSWORD=

# Supabase (public anon key + URL). Per-environment.
#   Prod:    https://ycdwtrklpoqprabtwahi.supabase.co
#   Staging: https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only — used by API routes that must bypass RLS).
# Per-environment.
SUPABASE_SERVICE_ROLE_KEY=

# SMTP — Amazon SES (eu-central-1). Replaces Ionos, which throttled/timed
# out from Render. Port 587 + STARTTLS (the transport sets requireTLS).
# SMTP_USER/SMTP_PASS are the SES *SMTP* credentials (not AWS API keys) —
# secrets, never commit. SMTP_FROM must be a verified SES identity
# (primundus.de is DKIM-verified). The edge function (send-scheduled-emails)
# reads the same values from Supabase Vault, NOT from these env vars — see
# docs/ses-email-migration.md for the per-environment cutover runbook.
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=kostenrechner@primundus.de
SMTP_FROM_NAME=Primundus 24h-Pflege
SMTP_ADMIN_EMAIL=
