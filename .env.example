# CAapp (Vite/React Kundenportal) — local dev environment
#
# Skopiuj ten plik jako `.env.local` i uzupełnij wartościami otrzymanymi
# od Michała osobnym kanałem (Signal / encrypted email).
#
#   cp .env.example .env.local
#   # edytuj .env.local
#
# UWAGA: `.env.local` jest w .gitignore — NIE commituj.
# Real values tylko lokalnie.
#
# ─── Two environments: prod + staging ─────────────────────────────────
# Wartości poniżej są dla PROD Supabase (ycdwtrklpoqprabtwahi). Render
# staging slot (caapp-staging.onrender.com) ma w swoim env wpisane
# wartości STAGING Supabase project. Dla local dev wystarczy prod-pointing
# (lub staging jeśli testujesz risky feature). Patrz docs/staging-environment-plan.md.

# Supabase project URL — prod = https://ycdwtrklpoqprabtwahi.supabase.co
# staging = https://<staging-ref>.supabase.co (po stworzeniu staging projektu)
VITE_SUPABASE_URL=https://ycdwtrklpoqprabtwahi.supabase.co

# Public anon key — Supabase publishuje go dla browsera. ALE konsystentnie
# trzymamy go w env (nie hardcode'ujemy w kod). Per-environment.
VITE_SUPABASE_ANON_KEY=

# Diagnostic overlay w portalu (otwiera się gdy `?debug=1` w URL).
# 1 = enabled lokalnie, 0 = disabled (prod/staging default).
VITE_DEBUG=1

# Kostenrechner base URL — used to report customer milestones back to the
# lead (portal_opened / patient_data_saved / caregiver_invited) so the
# follow-up emails can branch.
#   Local dev:       http://localhost:3000  (lub pomiń, brakuje feature)
#   Staging Render:  https://kostenrechner-staging.onrender.com
#   Prod:            https://kostenrechner.primundus.de
VITE_KOSTENRECHNER_URL=https://kostenrechner-beta.onrender.com
